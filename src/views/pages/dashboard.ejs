<!DOCTYPE html>
<html>
<head>
  <title>Admin Dashboard</title>
</head>
<body style="font-family: Arial, sans-serif; margin: 0; display: flex;">
  
  <%- include('../partials/sidebar') %>

  <div style="flex: 1; display: flex; flex-direction: column; background: #f9fafc;">
    <%- include('../partials/header') %>
    
    <div style="padding: 30px;">
      <h1>Job Management Matrix</h1>
      <p style="color: #7f8c8d;">Live status overview across matching processes</p>
      
      <div style="display: grid; grid-template-columns: repeat(auto-fill, minmax(180px, 1fr)); gap: 20px; margin-top: 30px;">
        <div style="background: white; padding: 20px; border-radius: 6px; box-shadow: 0 2px 5px rgba(0,0,0,0.05); border-left: 5px solid #f1c40f;">
          <h3 style="margin: 0; color: #7f8c8d;">Pending</h3>
          <p style="font-size: 32px; font-weight: bold; margin: 10px 0 0 0;"><%= stats.PENDING %></p>
        </div>
        <div style="background: white; padding: 20px; border-radius: 6px; box-shadow: 0 2px 5px rgba(0,0,0,0.05); border-left: 5px solid #3498db;">
          <h3 style="margin: 0; color: #7f8c8d;">Posted</h3>
          <p style="font-size: 32px; font-weight: bold; margin: 10px 0 0 0;"><%= stats.POSTED %></p>
        </div>
        <div style="background: white; padding: 20px; border-radius: 6px; box-shadow: 0 2px 5px rgba(0,0,0,0.05); border-left: 5px solid #9b59b6;">
          <h3 style="margin: 0; color: #7f8c8d;">Matched</h3>
          <p style="font-size: 32px; font-weight: bold; margin: 10px 0 0 0;"><%= stats.MATCHED %></p>
        </div>
        <div style="background: white; padding: 20px; border-radius: 6px; box-shadow: 0 2px 5px rgba(0,0,0,0.05); border-left: 5px solid #2ecc71;">
          <h3 style="margin: 0; color: #7f8c8d;">Completed</h3>
          <p style="font-size: 32px; font-weight: bold; margin: 10px 0 0 0;"><%= stats.COMPLETED %></p>
        </div>
        <div style="background: white; padding: 20px; border-radius: 6px; box-shadow: 0 2px 5px rgba(0,0,0,0.05); border-left: 5px solid #e74c3c;">
          <h3 style="margin: 0; color: #7f8c8d;">Cancelled</h3>
          <p style="font-size: 32px; font-weight: bold; margin: 10px 0 0 0;"><%= stats.CANCELLED %></p>
        </div>
      </div>
    </div>
  </div>
</body>
</html>