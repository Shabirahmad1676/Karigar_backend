<!DOCTYPE html>
<html>
<head><title>Job Match & Dissemination Console</title></head>
<body style="font-family: Arial, sans-serif; margin: 0; display: flex;">
  <%- include('../partials/sidebar') %>
  <div style="flex: 1; display: flex; flex-direction: column; background: #f9fafc;">
    <%- include('../partials/header') %>
    <div style="padding: 30px; display: grid; grid-template-columns: 1fr 1fr; gap: 30px;">
      
      <div style="background: white; padding: 25px; border-radius: 6px; box-shadow: 0 2px 5px rgba(0,0,0,0.05);">
        <h3 style="margin-top: 0; border-bottom: 2px solid #34495e; padding-bottom: 10px;">Job Profile Context</h3>
        <p><strong>Title:</strong> <%= job.title %></p>
        <p><strong>Description:</strong> <%= job.description %></p>
        <p><strong>Financial Budget Allocation:</strong> Rs. <%= job.budget %></p>
        <p><strong>Workflow Status Milestone:</strong> <span style="background: #f1c40f; padding: 3px 8px; font-weight: bold; border-radius: 3px;"><%= job.status %></span></p>
        
        <h4 style="margin-top: 25px;">Client Information Profile</h4>
        <p><strong>Name:</strong> <%= job.client.name %></p>
        <p><strong>Contact line:</strong> <%= job.client.phone %></p>
        
        <% if (job.status === 'PENDING') { %>
          <form action="/admin/jobs/<%= job.id %>/post" method="POST" style="margin-top: 30px;">
            <button type="submit" style="background: #27ae60; color: white; border: none; padding: 12px 20px; border-radius: 4px; font-weight: bold; cursor: pointer; width: 100%;">🚀 Verify & Mark "Posted to WhatsApp"</button>
          </form>
        <% } else { %>
          <div style="margin-top: 30px; background: #e8f8f5; border: 1px solid #2ecc71; padding: 15px; border-radius: 4px; color: #27ae60; font-weight: bold; text-align: center;">✓ Broadcast complete on WhatsApp Networks</div>
        <% } %>
      </div>

      <div style="background: white; padding: 25px; border-radius: 6px; box-shadow: 0 2px 5px rgba(0,0,0,0.05);">
        <h3 style="margin-top: 0; border-bottom: 2px solid #16a085; padding-bottom: 10px;">Match Assignment & Commission Settlement</h3>
        
        <form action="/admin/jobs/<%= job.id %>/match" method="POST">
          <div style="margin-bottom: 15px;">
            <label style="display: block; margin-bottom: 5px; font-weight: bold;">Assign Responding Technician:</label>
            <select name="technicianId" required style="width: 100%; padding: 10px;" id="techSelect">
              <option value="">-- Choose Operator --</option>
              <% technicians.forEach(t => { %>
                <option value="<%= t.id %>" data-city="<%= t.city %>" data-skill="<%= t.skillCategory %>">
                  <%= t.name %> (<%= t.skillCategory %> - <%= t.city %>)
                </option>
              <% }) %>
            </select>
          </div>

          <div style="margin-bottom: 15px;">
            <label style="display: block; margin-bottom: 5px; font-weight: bold;">Commission Charge (PKR):</label>
            <input type="number" name="commissionAmount" placeholder="e.g. 500" required style="width: 100%; padding: 10px; box-sizing: border-box;">
          </div>

          <div style="margin-bottom: 15px; padding: 10px; background: #f8f9fa; border-radius: 4px;">
            <input type="checkbox" name="commissionPaid" id="paidCheck" onchange="toggleReleaseCheckbox()">
            <label for="paidCheck" style="font-weight: bold; cursor: pointer; margin-left: 5px;">Mark Commission Paid In Ledger</label>
          </div>

          <div style="margin-bottom: 25px; padding: 10px; background: #f8f9fa; border-radius: 4px;">
            <input type="checkbox" name="releaseContact" id="releaseCheck" disabled>
            <label id="releaseLabel" for="releaseCheck" style="color: #7f8c8d; cursor: not-allowed; margin-left: 5px; font-weight: bold;">Release Contact Details (Requires Payment Verification)</label>
          </div>

          <button type="submit" style="width: 100%; background: #2c3e50; color: white; font-weight: bold; border: none; padding: 12px; border-radius: 4px; cursor: pointer;">Save Matching Matrix State</button>
        </form>

        <h4 style="margin-top: 30px;">Active Dissemination Logs</h4>
        <% job.matches.forEach(m => { %>
          <div style="border: 1px solid #ddd; padding: 10px; margin-top: 10px; border-radius: 4px; font-size: 14px;">
            <strong>Technician:</strong> <%= m.technician.name %><br/>
            <strong>Fee Amount:</strong> Rs. <%= m.commissionAmount %> (<%= m.status %>)
          </div>
        <% }) %>
      </div>
    </div>
  </div>

  <script>
    function toggleReleaseCheckbox() {
      const isPaid = document.getElementById('paidCheck').checked;
      const releaseBox = document.getElementById('releaseCheck');
      const releaseLabel = document.getElementById('releaseLabel');
      
      if (isPaid) {
        releaseBox.disabled = false;
        releaseLabel.style.color = '#2c3e50';
        releaseLabel.style.cursor = 'pointer';
      } else {
        releaseBox.disabled = true;
        releaseBox.checked = false;
        releaseLabel.style.color = '#7f8c8d';
        releaseLabel.style.cursor = 'not-allowed';
      }
    }
  </script>
</body>
</html>