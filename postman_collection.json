{
  "info": {
    "name": "Karigar Backend API",
    "_postman_id": "b1a2c3d4-e5f6-7890-ab12-cd34ef56gh78",
    "description": "Postman collection for Karigar backend API (local testing).",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Users",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/users",
          "host": ["{{baseUrl}}"],
          "path": ["users"]
        }
      },
      "response": []
    },
    {
      "name": "Auth / Register",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"Test Client\",\n  \"email\": \"client@example.com\",\n  \"password\": \"password123\",\n  \"role\": \"CLIENT\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/auth/register",
          "host": ["{{baseUrl}}"],
          "path": ["auth","register"]
        }
      },
      "response": []
    },
    {
      "name": "Auth / Login",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"client@example.com\",\n  \"password\": \"password123\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/auth/login",
          "host": ["{{baseUrl}}"],
          "path": ["auth","login"]
        }
      },
      "response": []
    },
    {
      "name": "Jobs / Get All",
      "request": {
        "method": "GET",
        "header": [{ "key": "Authorization", "value": "Bearer {{authToken}}" }],
        "url": {
          "raw": "{{baseUrl}}/jobs",
          "host": ["{{baseUrl}}"],
          "path": ["jobs"]
        }
      },
      "response": []
    },
    {
      "name": "Jobs / Create",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" },
          { "key": "Authorization", "value": "Bearer {{authToken}}" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"title\": \"Fix kitchen sink\",\n  \"description\": \"Pipe leaking and needs replacement\",\n  \"budget\": 1500,\n  \"clientId\": 1\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/jobs",
          "host": ["{{baseUrl}}"],
          "path": ["jobs"]
        }
      },
      "response": []
    },
    {
      "name": "Bids / Create Bid",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" },
          { "key": "Authorization", "value": "Bearer {{authToken}}" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"amount\": 1200,\n  \"technicianId\": 2\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/jobs/{{jobId}}/bids",
          "host": ["{{baseUrl}}"],
          "path": ["jobs","{{jobId}}","bids"]
        }
      },
      "response": []
    },
    {
      "name": "Bids / Accept Bid",
      "request": {
        "method": "PATCH",
        "header": [{ "key": "Authorization", "value": "Bearer {{authToken}}" }],
        "url": {
          "raw": "{{baseUrl}}/jobs/{{jobId}}/bids/{{bidId}}/accept",
          "host": ["{{baseUrl}}"],
          "path": ["jobs","{{jobId}}","bids","{{bidId}}","accept"]
        }
      },
      "response": []
    }
  ],
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:3000/api" },
    { "key": "authToken", "value": "" },
    { "key": "jobId", "value": "1" },
    { "key": "bidId", "value": "1" }
  ]
}
