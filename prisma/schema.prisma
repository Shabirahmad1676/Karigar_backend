datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum Role {
  CLIENT
  ADMIN
  TECHNICIAN
}

enum PriceType {
  FIXED
  CUSTOM
}

enum JobStatus {
  PENDING
  POSTED
  MATCHED
  COMPLETED
  CANCELLED
}

enum JobMatchStatus {
  PENDING
  COMMISSION_PAID
  CONTACT_SHARED
  COMPLETED
}

model User {
  id        Int      @id @default(autoincrement())
  name      String
  email     String   @unique
  phone     String
  password  String
  role      Role     @default(CLIENT)
  jobs      Job[]    @relation("ClientJobs")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// 1. ADD NEW MAIN CATEGORY MODEL WITH ICON META MAP ROLES
model Category {
  id        Int       @id @default(autoincrement())
  name      String    @unique // e.g., "Plumbing & Piping"
  iconName  String            // e.g., "water-outline" for your Ionicons engine
  isActive  Boolean   @default(true)
  services  Service[] @relation("CategoryToServices")
}

// 2. REFRACTOR SERVICE TO ENFORCE STRICT RELATIONAL NORMALIZATION
model Service {
  id          Int       @id @default(autoincrement())
  name        String    @unique // e.g., "Fixing Leaky Faucets"
  description String?           // Comprehensive scope baseline
  priceType   PriceType @default(CUSTOM)
  isActive    Boolean   @default(true)
  jobs        Job[]     @relation("ServiceJobs")

  categoryId  Int
  category    Category  @relation("CategoryToServices", fields: [categoryId], references: [id], onDelete: Cascade)
}

model Job {
  id          Int        @id @default(autoincrement())
  title       String
  description String
  budget      Int
  status      JobStatus  @default(PENDING)
  latitude    Float?
  longitude   Float?
  address     String?
  imageUrl    String?
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  clientId    Int
  client      User       @relation("ClientJobs", fields: [clientId], references: [id])

  serviceId   Int
  service     Service    @relation("ServiceJobs", fields: [serviceId], references: [id])
  
  matches     JobMatch[]

  @@index([status])
  @@index([clientId])
}

model Technician {
  id                Int        @id @default(autoincrement())
  name              String
  phone             String     @unique
  cnicImageUrl      String?
  skillCategory     String
  city              String
  whatsappGroupName String?
  isVerified        Boolean    @default(false)
  createdAt         DateTime   @default(now())
  updatedAt         DateTime   @updatedAt
  
  matches           JobMatch[]
}

model JobMatch {
  id               Int            @id @default(autoincrement())
  commissionAmount Float
  commissionPaid   Boolean        @default(false)
  contactSharedAt  DateTime?
  status           JobMatchStatus @default(PENDING)
  createdAt        DateTime       @default(now())

  jobId            Int
  job              Job            @relation(fields: [jobId], references: [id])

  technicianId     Int
  technician       Technician     @relation(fields: [technicianId], references: [id])
}