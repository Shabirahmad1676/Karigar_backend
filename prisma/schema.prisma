generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  CLIENT
  ADMIN
  TECHNICIAN
}

enum PriceType {
  FIXED
  CUSTOM
}

//  Added ARRIVED status to safely track active operational steps
enum JobStatus {
  PENDING
  POSTED
  MATCHED
  ARRIVED
  COMPLETED
  CANCELLED
}

enum JobMatchStatus {
  PENDING
  COMMISSION_PAID
  CONTACT_SHARED
  COMPLETED
}

enum VerificationStatus {
  UNVERIFIED     
  PENDING_DOCS   
  UNDER_REVIEW   
  VERIFIED       
  REJECTED       
}

//  Premium Monetization Tiers
enum TechTier {
  FREE
  PREMIUM
}

model User {
  id              Int      @id @default(autoincrement())
  name            String
  email           String   @unique
  phone           String   @unique
  password        String
  role            Role     @default(CLIENT)
  isPhoneVerified Boolean  @default(false) 
  jobs            Job[]    @relation("ClientJobs")
  reviewsWritten  Review[] @relation("ClientReviews")
  notifications Notification[]
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model Category {
  id        Int       @id @default(autoincrement())
  name      String    @unique
  iconName  String
  isActive  Boolean   @default(true)
  services  Service[] @relation("CategoryToServices")
}

model Service {
  id          Int       @id @default(autoincrement())
  name        String    @unique
  description String?
  priceType   PriceType @default(CUSTOM)
  isActive    Boolean   @default(true)
  jobs        Job[]     @relation("ServiceJobs")

  categoryId  Int
  category    Category  @relation("CategoryToServices", fields: [categoryId], references: [id], onDelete: Cascade)
}

model Job {
  id          Int        @id @default(autoincrement())
  title       String
  description String
  budget      Int
  status      JobStatus  @default(PENDING)
  latitude    Float?
  longitude   Float?
  address     String?
  imageUrl    String?
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  clientId    Int
  client      User       @relation("ClientJobs", fields: [clientId], references: [id])

  serviceId   Int
  service     Service    @relation("ServiceJobs", fields: [serviceId], references: [id])
  
  matches     JobMatch[]
  bids        Bid[]      @relation("JobToBids")
  review      Review?    @relation("JobToReview")
  chatRoom     ChatRoom?

  @@index([status])
  @@index([clientId])
}

model Technician {
  id                 Int                @id @default(autoincrement())
  name               String
  phone              String             @unique
  skillCategory      String
  city               String
  cnicNumber         String?            @unique 
  cnicImageUrl       String?
  selfieImageUrl     String?            
  verificationStatus VerificationStatus @default(UNVERIFIED) 
  isVerified         Boolean            @default(false)
  whatsappGroupName  String?

  latitude           Float?
  longitude          Float?
  
  tier               TechTier           @default(FREE)
  isWorking          Boolean            @default(false)
  
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt
  
  matches           JobMatch[]
  bids              Bid[]              @relation("TechnicianToBids")
  reviewsReceived   Review[]           @relation("TechnicianReviews")

  @@index([latitude, longitude])
}

model JobMatch {
  id               Int            @id @default(autoincrement())
  commissionAmount Float
  commissionPaid   Boolean        @default(false)
  contactSharedAt  DateTime?
  status           JobMatchStatus @default(PENDING)
  createdAt        DateTime       @default(now())

  jobId            Int
  job              Job            @relation(fields: [jobId], references: [id])

  technicianId     Int
  technician       Technician     @relation(fields: [technicianId], references: [id])
}

model Bid {
  id           Int        @id @default(autoincrement())
  amount       Int
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  jobId        Int
  job          Job        @relation("JobToBids", fields: [jobId], references: [id], onDelete: Cascade)

  technicianId Int
  technician   Technician @relation("TechnicianToBids", fields: [technicianId], references: [id], onDelete: Cascade)
  @@unique([jobId, technicianId])
}

//  Cohesive Trust Review Loop
model Review {
  id           Int        @id @default(autoincrement())
  rating       Int        
  comment      String?
  createdAt    DateTime   @default(now())

  jobId        Int        @unique
  job          Job        @relation("JobToReview", fields: [jobId], references: [id], onDelete: Cascade)

  clientId     Int
  client       User       @relation("ClientReviews", fields: [clientId], references: [id])

  technicianId Int
  technician   Technician @relation("TechnicianReviews", fields: [technicianId], references: [id], onDelete: Cascade)
}

model Notification {
  id          Int      @id @default(autoincrement())
  userId      Int      
  title       String
  message     String
  isRead      Boolean  @default(false)
  createdAt   DateTime @default(now())
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model ChatRoom {
  id           Int       @id @default(autoincrement())
  jobId        Int       @unique
  job          Job       @relation(fields: [jobId], references: [id], onDelete: Cascade)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  messages     Message[]

  @@index([jobId])
}

model Message {
  id         Int      @id @default(autoincrement())
  roomId     Int
  room       ChatRoom @relation(fields: [roomId], references: [id], onDelete: Cascade)
  senderId   Int      // Matches User.id (Client or Technician)
  text       String
  isRead     Boolean  @default(false)
  createdAt  DateTime @default(now())

  @@index([roomId])
  @@index([senderId])
}