generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// 1. Upgraded Role Matrix to natively include TECHNICIAN
enum Role {
  CLIENT
  ADMIN
  TECHNICIAN
}

enum PriceType {
  FIXED
  CUSTOM
}

enum JobStatus {
  PENDING
  POSTED
  MATCHED
  COMPLETED
  CANCELLED
}

enum JobMatchStatus {
  PENDING
  COMMISSION_PAID
  CONTACT_SHARED
  COMPLETED
}

// 2. Added Technician Identity Verification Status Tracker Enums
enum VerificationStatus {
  UNVERIFIED     // Registered phone number, but has not completed OTP verification
  PENDING_DOCS   // Phone OTP verified, but hasn't uploaded CNIC or Selfie
  UNDER_REVIEW   // CNIC and Selfie uploaded, waiting for Admin approval
  VERIFIED       // Approved by admin, fully allowed to place bids and take jobs
  REJECTED       // Verification rejected due to blurred or fraudulent documents
}

// User Model Configuration
model User {
  id              Int      @id @default(autoincrement())
  name            String
  email           String   @unique
  phone           String   @unique
  password        String
  role            Role     @default(CLIENT)
  isPhoneVerified Boolean  @default(false) // Added security signal check tracking line
  jobs            Job[]    @relation("ClientJobs")
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

// Category Relation Model
model Category {
  id        Int       @id @default(autoincrement())
  name      String    @unique
  iconName  String
  isActive  Boolean   @default(true)
  services  Service[] @relation("CategoryToServices")
}

// Service Model Configuration
model Service {
  id          Int       @id @default(autoincrement())
  name        String    @unique
  description String?
  priceType   PriceType @default(CUSTOM)
  isActive    Boolean   @default(true)
  jobs        Job[]     @relation("ServiceJobs")

  categoryId  Int
  category    Category  @relation("CategoryToServices", fields: [categoryId], references: [id], onDelete: Cascade)
}

// Job Model Configuration
model Job {
  id          Int        @id @default(autoincrement())
  title       String
  description String
  budget      Int
  status      JobStatus  @default(PENDING)
  latitude    Float?
  longitude   Float?
  address     String?
  imageUrl    String?
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  clientId    Int
  client      User       @relation("ClientJobs", fields: [clientId], references: [id])

  serviceId   Int
  service     Service    @relation("ServiceJobs", fields: [serviceId], references: [id])
  
  matches     JobMatch[]
  bids        Bid[]      @relation("JobToBids")
  @@index([status])
  @@index([clientId])
}

// 3. Upgraded Technician Verification Storage Layer
model Technician {
  id                 Int                @id @default(autoincrement())
  name               String
  phone              String             @unique
  skillCategory      String
  city               String
  cnicNumber         String?            @unique // Secure Unique identity check matching PTA constraints
  cnicImageUrl       String?
  selfieImageUrl     String?            // Biometric face matching validation target
  verificationStatus VerificationStatus @default(UNVERIFIED) // Controls real-time bidding gate permissions
  isVerified         Boolean            @default(false)
  whatsappGroupName  String?
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt
  
  matches           JobMatch[]
  bids              Bid[]      @relation("TechnicianToBids")
}

// JobMatch Model Configuration
model JobMatch {
  id               Int            @id @default(autoincrement())
  commissionAmount Float
  commissionPaid   Boolean        @default(false)
  contactSharedAt  DateTime?
  status           JobMatchStatus @default(PENDING)
  createdAt        DateTime       @default(now())

  jobId            Int
  job              Job            @relation(fields: [jobId], references: [id])

  technicianId     Int
  technician       Technician     @relation(fields: [technicianId], references: [id])
}
model Bid {
  id           Int        @id @default(autoincrement())
  amount       Int
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  jobId        Int
  job          Job        @relation("JobToBids", fields: [jobId], references: [id], onDelete: Cascade) // 👈 UPDATE THIS LINE

  technicianId Int
  technician   Technician @relation("TechnicianToBids", fields: [technicianId], references: [id], onDelete: Cascade) // 👈 UPDATE THIS LINE
}